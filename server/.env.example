# Database
DATABASE_URL=postgresql://postgres:RodicPo2024%40@localhost:5432/bellissimo_couture
# JWT
JWT_ACCESS_SECRET=01865daf28e7d95348e22b6f61e9c1adb7d4949fb2d20f7cd04d6715cae2ccb8
JWT_REFRESH_SECRET=5560b15cec6f831c95ca38fbe71bae3f6ba1e608dbce2fe5c1b15d6961b07621
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Required to create ADMIN users from the Users admin page.
# Treat this like a root password: long, random, known to the owner only,
# never committed, never logged. If unset, the "Create admin" path is disabled.
ADMIN_CREATION_SECRET=replace_with_a_long_random_string

# Razorpay
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Set in Razorpay Dashboard -> Settings -> Webhooks. Must match the secret you
# enter when registering the webhook URL.
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
# Public HTTPS URL where Razorpay sends webhooks. In dev, run `ngrok http 5000`
# and paste the https URL here. The webhook endpoint is /api/webhooks/razorpay
# so the full URL registered in the Razorpay dashboard becomes
# <PUBLIC_BASE_URL>/api/webhooks/razorpay.
PUBLIC_BASE_URL=https://your-ngrok-subdomain.ngrok-free.app

# In production, force HTTPS redirect (set to "false" only if your proxy already does it).
FORCE_HTTPS=true

# SMTP (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=bellisssimocouture@gmail.com
SMTP_PASS=your_app_password
FROM_EMAIL=bellisssimocouture@gmail.com
FROM_NAME=Bellissimo Couture

# Public contact info (used in transactional emails / footer)
CONTACT_EMAIL=bellisssimocouture@gmail.com
CONTACT_PHONE=+917217788633
CONTACT_WHATSAPP=917217788633

# Brand assets used in transactional email headers and footers. These must be
# publicly reachable HTTP(S) URLs (mail clients won't render localhost or
# protected paths). Recommended size: logo ~600x180, footer ~600x300.
BRAND_LOGO_URL=https://bellissimocouture.com/email/header-logo.png
BRAND_FOOTER_URL=https://bellissimocouture.com/email/brand-footer.png
BRAND_TAGLINE=Designer Attire. Timeless Impression.
BRAND_WEBSITE_URL=https://bellissimocouture.com

# Google Calendar / Meet (for auto-creating consultation Meet events).
# See SETUP_GOOGLE_MEET.md for one-time setup steps.
# If unset, bookings stay in PENDING and admin pastes a Meet link manually.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5000/api/admin/google/callback
GOOGLE_OAUTH_REFRESH_TOKEN=

# Application
CLIENT_URL=http://localhost:5173
PORT=5000
NODE_ENV=development

# Logging. Files are written to server/logs (error-*.log, combined-*.log,
# exceptions-*.log, rejections-*.log), rotated daily, kept 30 days, gzipped.
# Level: error < warn < info < http < verbose < debug. Default: http in
# production, debug otherwise.
LOG_LEVEL=
