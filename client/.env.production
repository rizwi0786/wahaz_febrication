# Production build settings (used only by `vite build`).
# Same-origin: IIS reverse-proxies /api to the Node server, so the client
# calls a relative /api path — no CORS, cookies work.
VITE_API_URL=/api

# Razorpay public key id for the LIVE storefront. Replace with your real
# live key before going live, or payments will fail to open the checkout.
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id
