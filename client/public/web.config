<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS config for the Bellissimo Couture SPA + API reverse proxy.

  This file lives in client/public/ so `vite build` copies it into dist/.
  The IIS site's physical path should point at the built dist/ folder.

  Requires these IIS modules on the server (one-time install):
    - URL Rewrite 2.1
    - Application Request Routing (ARR) 3.0  -> then enable "proxy" at the
      server level: IIS Manager > (server node) > Application Request Routing
      Cache > Server Proxy Settings > tick "Enable proxy" > Apply.

  The Node/Express API must be listening on http://localhost:5000.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- 1) Reverse-proxy every /api/* request to the Node server.
             Must come BEFORE the SPA fallback. -->
        <rule name="ReverseProxyToNodeAPI" stopProcessing="true">
          <match url="^api/(.*)" />
          <action type="Rewrite" url="http://localhost:5000/api/{R:1}" />
        </rule>

        <!-- 2) SPA fallback: anything that is not a real file/dir and not an
             /api call is served by the React app's index.html so client-side
             routing (e.g. /shop, /product/...) works on refresh / deep links. -->
        <rule name="SPAFallback" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{REQUEST_URI}" pattern="^/api/" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>

    <!-- Let API error responses (401/404/500 JSON) pass through untouched
         instead of IIS replacing them with its own error pages. -->
    <httpErrors existingResponse="PassThrough" />

    <security>
      <requestFiltering>
        <!-- Allow up to 50 MB uploads (product images are sent as base64). -->
        <requestLimits maxAllowedContentLength="52428800" />
      </requestFiltering>
    </security>

    <!-- Correct MIME types for modern build assets. -->
    <staticContent>
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
    </staticContent>

    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
