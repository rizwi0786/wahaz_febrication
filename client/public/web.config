<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS config for the Bellissimo Couture SPA + API reverse proxy.

  This file lives in client/public/ so `vite build` copies it into dist/.
  The IIS site's physical path should point at the built dist/ folder.

  Requires these IIS modules on the server (one-time install):
    - URL Rewrite 2.1
    - Application Request Routing (ARR) 3.0  -> then enable "proxy" at the
      server level: IIS Manager > (server node) > Application Request Routing
      Cache > Server Proxy Settings > tick "Enable proxy" > Apply.

  The Node/Express API must be listening on http://localhost:5000.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- 0) Canonical host: 301 www.* to the bare domain. Without this,
             pages served from www call the API on the apex origin and every
             request dies on CORS (blank storefront). Cloudflare proxies www
             here, we bounce the browser back to the canonical host. -->
        <rule name="RedirectWWWToApex" stopProcessing="true">
          <match url=".*" />
          <conditions>
            <add input="{HTTP_HOST}" pattern="^www\.(.+)$" />
          </conditions>
          <action type="Redirect" url="https://{C:1}/{R:0}" redirectType="Permanent" />
        </rule>

        <!-- 0b) Enforce HTTPS. Cloudflare forwards the visitor's scheme in
             X-Forwarded-Proto; plain-http visitors are bounced to https
             BEFORE anything is served or proxied. Without this, Node's own
             https redirect gets its Location header rewritten back to http
             by ARR, looping /api requests forever (ERR_TOO_MANY_REDIRECTS). -->
        <rule name="RedirectHttpToHttps" stopProcessing="true">
          <match url=".*" />
          <conditions>
            <add input="{HTTP_X_FORWARDED_PROTO}" pattern="^http$" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:0}" redirectType="Permanent" />
        </rule>

        <!-- 1) Reverse-proxy every /api/* request to the Node server.
             Must come BEFORE the SPA fallback. -->
        <rule name="ReverseProxyToNodeAPI" stopProcessing="true">
          <match url="^api/(.*)" />
          <action type="Rewrite" url="http://localhost:5000/api/{R:1}" />
        </rule>

        <!-- 2) SPA fallback: anything that is not a real file/dir and not an
             /api call is served by the React app's index.html so client-side
             routing (e.g. /shop, /product/...) works on refresh / deep links. -->
        <rule name="SPAFallback" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{REQUEST_URI}" pattern="^/api/" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>

    <!-- Let API error responses (401/404/500 JSON) pass through untouched
         instead of IIS replacing them with its own error pages. -->
    <httpErrors existingResponse="PassThrough" />

    <security>
      <requestFiltering>
        <!-- Allow up to 50 MB uploads (product images are sent as base64). -->
        <requestLimits maxAllowedContentLength="52428800" />
      </requestFiltering>
    </security>

    <!-- Correct MIME types for modern build assets. -->
    <staticContent>
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
    </staticContent>

    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <!-- Pin browsers to https after their first secure visit. (Browsers
             ignore HSTS received over plain http, so sending it always is safe.) -->
        <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains; preload" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
